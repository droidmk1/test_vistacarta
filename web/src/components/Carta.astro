---
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import '@fontsource/figtree/600.css';
import '@fontsource/figtree/700.css';
import '@fontsource/figtree/800.css';
import '../styles/menu.css';

import iSearch from 'lucide-static/icons/search.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';
import iCheck from 'lucide-static/icons/check.svg?raw';
import iGrid from 'lucide-static/icons/layout-grid.svg?raw';
import iList from 'lucide-static/icons/list.svg?raw';
import iSort from 'lucide-static/icons/arrow-up-down.svg?raw';
import iInfo from 'lucide-static/icons/info.svg?raw';
import iChevron from 'lucide-static/icons/chevron-down.svg?raw';
import iCarta from 'lucide-static/icons/book-open.svg?raw';
import iInstagram from 'lucide-static/icons/instagram.svg?raw';
import iFacebook from 'lucide-static/icons/facebook.svg?raw';
import iWhatsapp from 'lucide-static/icons/message-circle.svg?raw';
import iResena from 'lucide-static/icons/star.svg?raw';
import iPin from 'lucide-static/icons/map-pin.svg?raw';
import iClock from 'lucide-static/icons/clock.svg?raw';
import iPhone from 'lucide-static/icons/phone.svg?raw';
import iCalendar from 'lucide-static/icons/calendar-check.svg?raw';
import { ALERGENOS, ALERGENO, nombreAlergeno } from '../alergenos.js';
import { IDIOMAS, UI, BANDERAS } from '../i18n.js';

const { menu } = Astro.props;
const R = menu.restaurante;

// Idiomas: una sola página. El primero de restaurante.idiomas es el de la carta original;
// el desplegable de arriba cambia los textos en el navegador sin recargar.
const idiomas = (R.idiomas?.length ? R.idiomas : ['es']).filter((l) => IDIOMAS[l]);
const lang = idiomas[0] ?? 'es';
const t = UI[lang] ?? UI.es;
const multi = idiomas.length > 1;
// Texto de un objeto de la carta (categoría o plato) en el idioma l, o el original si falta.
const trL = (obj, campo, l) => (l !== lang && obj.traducciones?.[l]?.[campo]) || obj[campo];

const moneda = new Intl.NumberFormat(IDIOMAS[lang].locale, { style: 'currency', currency: R.moneda || 'EUR' });
const fmt = (valor) => moneda.format(valor);
const slugify = (texto) =>
  texto
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
const listaL = (xs, u) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} ${u.y} ${xs.at(-1)}` : (xs[0] ?? ''));
const capital = (s) => s.charAt(0).toUpperCase() + s.slice(1);

// Rutas de archivos propios (logo, fotos): relativas a web/public o URL completa.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const recurso = (u) => (!u ? null : /^https?:\/\//.test(u) ? u : base + u.replace(/^\//, ''));

const categorias = menu.categorias.map((categoria) => ({ ...categoria, id: slugify(categoria.nombre) }));
const total = categorias.reduce((n, c) => n + c.platos.length, 0);
const platos = categorias.flatMap((c) => c.platos);

// Funciones opcionales: aparecen solo si hay datos.
const hayFotos = platos.some((p) => p.foto_url);
const destacados = platos.filter((p) => p.destacado);
const enOferta = (p) => typeof p.precio_anterior === 'number' && p.precio_anterior > p.precio;
const descuento = (p) => Math.round((1 - p.precio / p.precio_anterior) * 100);

const dia = menu.menu_del_dia ?? null;
const diaIncluye = dia?.incluye?.length ? capital(listaL(dia.incluye, t)) : '';
const diaHorarioCorto = dia?.horario ? dia.horario.replace(/^De lunes a viernes, de /, 'L–V ').replace(/ h$/, '') : '';
const [nombreCorto, ...resto] = R.nombre.split(' ');
const apellido = resto.join(' ');
const borrador = menu.estado === 'borrador';
const logo = recurso(R.logo_url);

// Colores de la marca. Sin ellos, el rojo y la mostaza de la plantilla.
const hexOk = (c) => typeof c === 'string' && /^#[0-9a-f]{6}$/i.test(c);
const rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const lum = (h) => {
  const [r, g, b] = rgb(h).map((v) => {
    v /= 255;
    return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contraste = (a, b) => {
  const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
  return (x + 0.05) / (y + 0.05);
};
const INK = '#1f1a17';
const sobre = (fondo) => (contraste(fondo, '#ffffff') >= 4.5 ? '#ffffff' : INK);
// Oscurece el color hasta que se lea como texto sobre blanco (4.5:1).
const comoTexto = (h) => {
  let c = h;
  while (contraste(c, '#ffffff') < 4.5) {
    c = '#' + rgb(c).map((v) => Math.round(v * 0.9).toString(16).padStart(2, '0')).join('');
  }
  return c;
};
const primario = hexOk(R.colores?.primario) ? R.colores.primario : '#c8102e';
const secundario = hexOk(R.colores?.secundario) ? R.colores.secundario : '#f2b705';
const tema = `--red:${primario};--on-red:${sobre(primario)};--red-text:${comoTexto(primario)};--mustard:${secundario};--on-mustard:${sobre(secundario)}`;

// Redes y contacto. Solo se muestra lo que exista en menu.json.
const redes = R.redes ?? {};
const wa = redes.whatsapp?.numero
  ? `https://wa.me/${String(redes.whatsapp.numero).replace(/\D/g, '')}${redes.whatsapp.mensaje ? `?text=${encodeURIComponent(redes.whatsapp.mensaje)}` : ''}`
  : null;
const acciones = [
  redes.reservas_url
    ? { href: redes.reservas_url, icono: iCalendar, corto: 'reservar', largo: 'reservarMesa' }
    : wa && { href: wa, icono: iWhatsapp, corto: 'reservar', largo: 'reservarWa' },
  redes.instagram && { href: redes.instagram, icono: iInstagram, corto: null, largo: 'seguirIg' },
  redes.google_resenas && { href: redes.google_resenas, icono: iResena, corto: 'resenas', largo: 'dejarResena' },
].filter(Boolean);
const sociales = [
  redes.instagram && { href: redes.instagram, icono: iInstagram, nombre: 'Instagram' },
  redes.facebook && { href: redes.facebook, icono: iFacebook, nombre: 'Facebook' },
  wa && { href: wa, icono: iWhatsapp, nombre: 'WhatsApp' },
].filter(Boolean);
const contacto = R.contacto ?? {};
const horarios = [contacto.horario].flat().filter(Boolean);
const mapa = contacto.mapa_url ?? (contacto.direccion ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${R.nombre}, ${contacto.direccion}`)}` : null);
const hayPropuestos = platos.some((p) => p.alergenos?.length && !p.alergenos_confirmados);
const anio = new Date().getFullYear();

// Diccionario por idioma para el navegador: textos de interfaz + contenido de la carta.
const frasePrueba = (l) => {
  const u = UI[l];
  const sug = categorias.slice(0, 3).map((c) => `«${trL(c, 'nombre', l).toLowerCase()}»`);
  return `${u.prueba} ${listaL(sug, u).replace(new RegExp(` ${u.y} («[^»]*»)$`), ` ${u.o} $1`)}.`;
};
const diccionario = {};
for (const l of idiomas) {
  const u = UI[l];
  const d = Object.fromEntries(Object.entries(u).filter(([, v]) => typeof v === 'string'));
  d.titulo = `${R.nombre} · ${u.titulo}`;
  d.marca = `${R.nombre}, ${u.irInicio}`;
  d.prueba = frasePrueba(l);
  d.alergiasTexto = `${hayPropuestos ? u.propuestos + ' ' : ''}${u.ausencia}`;
  for (const c of categorias) d[`c:${c.id}`] = trL(c, 'nombre', l);
  for (const p of platos) {
    d[`p:${p.id}:n`] = trL(p, 'nombre', l);
    const desc = trL(p, 'descripcion', l);
    if (desc) d[`p:${p.id}:d`] = desc;
  }
  for (const a of ALERGENOS) d[`a:${a.id}`] = nombreAlergeno(a, l);
  diccionario[l] = d;
}
const datosJs = JSON.stringify({
  original: lang,
  slug: R.slug,
  moneda: R.moneda || 'EUR',
  locales: Object.fromEntries(idiomas.map((l) => [l, IDIOMAS[l].locale])),
  d: diccionario,
});
---
<!doctype html>
<html lang={lang} style={tema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={primario} />
    <title>{R.nombre} · {t.titulo}</title>
    <meta name="description" content={t.descripcion(R.nombre, total)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="inicio">
    <script type="application/json" id="vc-datos" set:html={datosJs} />

    {multi && (
      <div class="idiomas">
        <details class="idioma-menu" id="idioma-menu">
          <summary data-ta="aria-label=idioma" aria-label={t.idioma}>
            <span class="bandera" id="idioma-bandera" set:html={BANDERAS[lang]} />
            <span id="idioma-nombre">{IDIOMAS[lang].nombre}</span>
            <span class="ico chevron" set:html={iChevron} />
          </summary>
          <ul class="idioma-lista">
            {idiomas.map((l) => (
              <li>
                <button type="button" data-set-lang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                  <span class="bandera" set:html={BANDERAS[l]} />
                  <span>{IDIOMAS[l].nombre}</span>
                  <span class="ico check" set:html={iCheck} />
                </button>
              </li>
            ))}
          </ul>
        </details>
      </div>
    )}

    <header class="appbar">
      <a class="brand" href="#inicio" data-ta="aria-label=marca" aria-label={`${R.nombre}, ${t.irInicio}`}>
        {logo ? (
          <span class="brand-logo"><img src={logo} alt="" height="36" /></span>
        ) : (
          <span class="monogram" aria-hidden="true">{nombreCorto.charAt(0)}</span>
        )}
        <span class:list={['brand-text', { 'sr-only': logo }]}>
          <span class="brand-name">{nombreCorto}</span>
          {apellido && <span class="brand-sub">{apellido}</span>}
        </span>
      </a>
      <button class="search-btn" type="button" data-open-search aria-controls="buscador" aria-expanded="false">
        <span class="ico" set:html={iSearch} />
        <span data-t="buscar">{t.buscar}</span>
      </button>
    </header>

    <div class="searchbar" id="buscador" hidden>
      <label class="search-field">
        <span class="ico" set:html={iSearch} />
        <span class="sr-only" data-t="buscarEnCarta">{t.buscarEnCarta}</span>
        <input id="q" type="search" data-ta="placeholder=buscarPlaceholder" placeholder={t.buscarPlaceholder} autocomplete="off" enterkeyhint="search" />
      </label>
      <button class="text-btn" type="button" data-close-search data-t="cancelar">{t.cancelar}</button>
    </div>

    <main>
      {acciones.length > 0 && (
        <nav class="acciones" data-ta="aria-label=reservasRedes" aria-label={t.reservasRedes}>
          {acciones.map((a) => (
            <a class="accion" href={a.href} target="_blank" rel="noopener" data-ta={`aria-label=${a.largo}`} aria-label={t[a.largo]}>
              <span class="ico" set:html={a.icono} />
              {a.corto ? <span data-t={a.corto}>{t[a.corto]}</span> : <span>Instagram</span>}
            </a>
          ))}
        </nav>
      )}

      {dia && (
      <section class="dia" id="menu-dia" aria-labelledby="dia-titulo">
        <div class="dia-head">
          <div>
            <h2 id="dia-titulo">{dia.nombre}</h2>
            {diaIncluye && <p class="dia-meta">{diaIncluye}</p>}
            {(diaHorarioCorto || dia.excluye) && (
              <p class="dia-meta">{[diaHorarioCorto && `${diaHorarioCorto} h`, dia.excluye && `${t.noIncluye} ${dia.excluye.toLowerCase()}`].filter(Boolean).join(' · ')}</p>
            )}
          </div>
          <p class="dia-price" data-precio={dia.precio}>{fmt(dia.precio)}</p>
        </div>
        <details class="dia-detalle">
          <summary>
            <span class="cta-abrir" data-t="verMenu">{t.verMenu}</span>
            <span class="cta-cerrar" data-t="ocultarMenu">{t.ocultarMenu}</span>
            <span class="ico" set:html={iChevron} />
          </summary>
          <div class="dia-cols">
            <div>
              <h3 data-t="entrantes">{t.entrantes}</h3>
              <ul>
                {(dia.entrantes ?? []).map((plato) => (
                  <li>
                    <span>{plato.nombre}</span>
                    {plato.suplemento > 0 && <span class="extra" data-precio={plato.suplemento} data-prefijo="+">+{fmt(plato.suplemento)}</span>}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 data-t="segundos">{t.segundos}</h3>
              <ul>
                {(dia.segundos ?? []).map((nombre) => <li><span>{nombre}</span></li>)}
              </ul>
            </div>
            {dia.suplementos_bebida?.length > 0 && (
            <div>
              <h3 data-t="bebidaSuplemento">{t.bebidaSuplemento}</h3>
              <ul>
                {dia.suplementos_bebida.map((bebida) => (
                  <li>
                    <span>{bebida.nombre}</span>
                    <span class="extra" data-precio={bebida.suplemento} data-prefijo="+">+{fmt(bebida.suplemento)}</span>
                  </li>
                ))}
              </ul>
            </div>
            )}
          </div>
        </details>
      </section>
      )}

      {destacados.length > 0 && (
        <section class="favoritos" aria-labelledby="fav-t">
          <h2 class="bloque-t" id="fav-t" data-t="favoritos">{t.favoritos}</h2>
          <ul class="fav-list">
            {destacados.map((p) => (
              <li class:list={['fav', { 'has-foto': p.foto_url }]}>
                {p.foto_url && <img class="fav-foto" src={recurso(p.foto_url)} alt="" loading="lazy" />}
                <span class="fav-name" data-t={`p:${p.id}:n`}>{p.nombre}</span>
                <span class="fav-price">
                  {enOferta(p) && <s data-precio={p.precio_anterior}>{fmt(p.precio_anterior)}</s>}
                  <span data-precio={p.precio}>{fmt(p.precio)}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div id="carta" class="ancla" aria-hidden="true"></div>
      <nav class="cats" data-ta="aria-label=categorias" aria-label={t.categorias}>
        <ul>
          {categorias.map((categoria, i) => (
            <li>
              <a class="cat" href={`#${categoria.id}`} data-cat={categoria.id} data-t={`c:${categoria.id}`} aria-current={i === 0 ? 'true' : undefined}>{categoria.nombre}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="toolbar">
        <p class="count" id="contador" aria-live="polite">{total} {t.platos}</p>
        <div class="toolbar-actions">
          {hayFotos && (
            <div class="view-toggle" role="group" data-ta="aria-label=vista" aria-label={t.vista}>
              <button type="button" class="seg" data-view="list" aria-pressed="true">
                <span class="ico" set:html={iList} />
                <span class="seg-text" data-t="lista">{t.lista}</span>
              </button>
              <button type="button" class="seg" data-view="grid" aria-pressed="false">
                <span class="ico" set:html={iGrid} />
                <span class="seg-text" data-t="fotos">{t.fotos}</span>
              </button>
            </div>
          )}
          <button type="button" class="sort" id="abrir-orden" aria-haspopup="dialog" aria-controls="hoja-orden">
            <span class="ico" set:html={iSort} />
            <span data-t="ordenar">{t.ordenar}</span>
            <span class="sort-current" id="orden-actual" hidden></span>
          </button>
        </div>
      </div>

      <div class="sections" data-view="list">
        {categorias.map((categoria) => (
          <section class="cat-section" id={categoria.id} data-cat={categoria.id} aria-labelledby={`${categoria.id}-t`}>
            <h2 class="cat-title" id={`${categoria.id}-t`} data-t={`c:${categoria.id}`}>{categoria.nombre}</h2>
            <ul class="dishes">
              {categoria.platos.map((plato, i) => (
                <li
                  class:list={['dish', { 'is-off': !plato.disponible, 'has-foto': plato.foto_url }]}
                  data-id={plato.id}
                  data-name={plato.nombre}
                  data-alt={plato.nombre}
                  data-price={plato.precio}
                  data-order={i}
                >
                  {plato.foto_url && <img class="dish-foto" src={recurso(plato.foto_url)} alt="" loading="lazy" />}
                  <div class="dish-body">
                    <div class="dish-head">
                      <h3 class="dish-name" data-t={`p:${plato.id}:n`}>{plato.nombre}</h3>
                      <p class="dish-price">
                        {enOferta(plato) && <s class="precio-antes"><span class="sr-only" data-t="antes">{t.antes}</span> <span data-precio={plato.precio_anterior}>{fmt(plato.precio_anterior)}</span></s>}
                        <span data-precio={plato.precio}>{fmt(plato.precio)}</span>
                      </p>
                    </div>
                    {plato.descripcion && <p class="dish-desc" data-t={`p:${plato.id}:d`}>{plato.descripcion}</p>}
                    {plato.alergenos?.length > 0 && (
                      <div class="alg">
                        <span class="alg-label" data-t={plato.alergenos_confirmados ? 'alergenos' : 'posibles'}>{plato.alergenos_confirmados ? t.alergenos : t.posibles}</span>
                        <ul class="alg-list">
                          {plato.alergenos.filter((id) => ALERGENO[id]).map((id) => (
                            <li><span class="ico" set:html={ALERGENO[id].icono} /><span data-t={`a:${id}`}>{nombreAlergeno(ALERGENO[id], lang)}</span></li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {(!plato.disponible || enOferta(plato)) && (
                      <p class="dish-badges">
                        {enOferta(plato) && <span class="badge badge-oferta">-{descuento(plato)}%</span>}
                        {!plato.disponible && <span class="badge" data-t="agotado">{t.agotado}</span>}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <div class="empty" id="vacio" hidden>
          <p class="empty-title"><span data-t="sinResultados">{t.sinResultados}</span> «<span id="vacio-q"></span>»</p>
          <p data-t="prueba">{frasePrueba(lang)}</p>
          <button class="text-btn" type="button" data-clear-search data-t="verTodo">{t.verTodo}</button>
        </div>
      </div>

      <section class="info" id="info" aria-labelledby="info-t">
        <h2 class="bloque-t" id="info-t" data-t="informacion">{t.informacion}</h2>
        <dl>
          {dia?.horario && (
            <div>
              <dt>{dia.nombre}</dt>
              <dd>{dia.horario}.{dia.excluye && ` ${t.noIncluye} ${dia.excluye.toLowerCase()}.`}</dd>
            </div>
          )}
          <div>
            <dt data-t="alergias">{t.alergias}</dt>
            <dd data-t="alergiasTexto">{hayPropuestos && `${t.propuestos} `}{t.ausencia}</dd>
          </div>
          {multi && (
            <div data-solo-traducida hidden>
              <dt data-t="traduccion">{t.traduccion}</dt>
              <dd data-t="traduccionTexto">{t.traduccionTexto}</dd>
            </div>
          )}
          {borrador && (
            <div>
              <dt data-t="revision">{t.revision}</dt>
              <dd data-t="revisionTexto">{t.revisionTexto}</dd>
            </div>
          )}
        </dl>

        <h3 class="leyenda-t" id="alergenos" data-t="los14">{t.los14}</h3>
        <ul class="leyenda">
          {ALERGENOS.map((a) => (
            <li><span class="ico" set:html={a.icono} /><span data-t={`a:${a.id}`}>{nombreAlergeno(a, lang)}</span></li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="pie">
      <div class="pie-inner">
        {logo ? (
          <span class="pie-logo"><img src={logo} alt={R.nombre} height="48" loading="lazy" /></span>
        ) : (
          <p class="pie-nombre">{R.nombre}</p>
        )}

        {sociales.length > 0 && (
          <div class="pie-redes">
            <p data-t="siguenos">{t.siguenos}</p>
            <ul>
              {sociales.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" aria-label={s.nombre}><span class="ico" set:html={s.icono} /></a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {(contacto.direccion || horarios.length > 0 || contacto.telefono) && (
          <ul class="pie-datos">
            {contacto.direccion && (
              <li><span class="ico" set:html={iPin} /><a href={mapa} target="_blank" rel="noopener">{contacto.direccion}</a></li>
            )}
            {horarios.length > 0 && (
              <li><span class="ico" set:html={iClock} /><span>{horarios.map((h) => <span class="pie-linea">{h}</span>)}</span></li>
            )}
            {contacto.telefono && (
              <li><span class="ico" set:html={iPhone} /><a href={`tel:${contacto.telefono.replace(/[^\d+]/g, '')}`}>{contacto.telefono}</a></li>
            )}
          </ul>
        )}

        {redes.google_resenas && (
          <a class="pie-resena" href={redes.google_resenas} target="_blank" rel="noopener">
            <span class="ico" set:html={iResena} /><span data-t="dejarResenaPie">{t.dejarResenaPie}</span>
          </a>
        )}

        <p class="pie-legal">© {anio} {R.nombre}</p>
      </div>
    </footer>

    <dialog class="sheet" id="hoja-orden" aria-labelledby="hoja-orden-t">
      <form method="dialog" class="sheet-inner">
        <div class="sheet-head">
          <h2 id="hoja-orden-t" data-t="ordenarPor">{t.ordenarPor}</h2>
          <button class="icon-btn sheet-close" value="cancel" formnovalidate data-ta="aria-label=cerrar" aria-label={t.cerrar}>
            <span class="ico" set:html={iX} />
          </button>
        </div>
        <fieldset class="sheet-options">
          <legend class="sr-only" data-t="ordenPlatos">{t.ordenPlatos}</legend>
          {[
            ['carta', 'recomendado'],
            ['precio-asc', 'precioAsc'],
            ['precio-desc', 'precioDesc'],
            ['nombre', 'az'],
            ['nombre-desc', 'za'],
          ].map(([valor, clave], i) => (
            <label class="sheet-option">
              <input type="radio" name="orden" value={valor} checked={i === 0} />
              <span data-t={clave}>{t[clave]}</span>
              <span class="ico check" set:html={iCheck} />
            </label>
          ))}
        </fieldset>
        <button class="sheet-apply" value="apply" data-t="mostrar">{t.mostrar}</button>
      </form>
    </dialog>

    <nav class="bottomnav" data-ta="aria-label=navegacion" aria-label={t.navegacion}>
      <a href="#carta" data-nav="carta" aria-current="page"><span class="ico" set:html={iCarta} /><span data-t="carta">{t.carta}</span></a>
      <button type="button" data-open-search data-nav="buscar"><span class="ico" set:html={iSearch} /><span data-t="buscar">{t.buscar}</span></button>
      <a href="#info" data-nav="info"><span class="ico" set:html={iInfo} /><span data-t="info">{t.info}</span></a>
    </nav>

    <script>
      const V = JSON.parse(document.getElementById('vc-datos').textContent);
      const root = document.querySelector('.sections');
      const sections = [...document.querySelectorAll('.cat-section')];
      const chips = [...document.querySelectorAll('.cat')];
      const counter = document.getElementById('contador');
      const empty = document.getElementById('vacio');
      const emptyQ = document.getElementById('vacio-q');
      const searchbar = document.getElementById('buscador');
      const input = document.getElementById('q');
      const sheet = document.getElementById('hoja-orden');
      const sortOpen = document.getElementById('abrir-orden');
      const sortCurrent = document.getElementById('orden-actual');
      const radios = [...sheet.querySelectorAll('input[name="orden"]')];
      let sortMode = 'carta';
      const viewBtns = [...document.querySelectorAll('button[data-view]')];
      const openers = [...document.querySelectorAll('[data-open-search]')];
      const navItems = [...document.querySelectorAll('.bottomnav [data-nav]')];

      const norm = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
      const store = {
        get: (k) => { try { return localStorage.getItem(k); } catch { return null; } },
        set: (k, v) => { try { localStorage.setItem(k, v); } catch {} },
      };

      let lang = V.original;
      const D = () => V.d[lang] ?? V.d[V.original];
      const plural = (n) => `${n} ${n === 1 ? D().plato : D().platos}`;

      let active = sections[0]?.dataset.cat;
      let query = '';

      function setNav(which) {
        navItems.forEach((el) => {
          if (el.dataset.nav === which) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        });
      }

      function render() {
        const q = norm(query.trim());
        let visible = 0;
        for (const sec of sections) {
          const dishes = [...sec.querySelectorAll('.dish')];
          let shown = 0;
          for (const d of dishes) {
            // Se busca en el idioma elegido y también por el nombre original.
            const hit = q ? norm(d.dataset.name + ' ' + d.dataset.alt).includes(q) : sec.dataset.cat === active;
            d.hidden = !hit;
            if (hit) shown++;
          }
          sec.hidden = shown === 0;
          sec.classList.toggle('show-title', Boolean(q));
          visible += shown;
        }
        for (const c of chips) {
          if (!q && c.dataset.cat === active) c.setAttribute('aria-current', 'true');
          else c.removeAttribute('aria-current');
        }
        empty.hidden = visible > 0;
        emptyQ.textContent = query.trim();
        const name = chips.find((c) => c.dataset.cat === active)?.textContent;
        counter.textContent = q ? `${plural(visible)} ${D().con} «${query.trim()}»` : `${name} · ${plural(visible)}`;
      }

      function sortDishes(mode) {
        const loc = V.locales[lang];
        for (const sec of sections) {
          const list = sec.querySelector('.dishes');
          const items = [...list.children];
          const by = {
            carta: (a, b) => a.dataset.order - b.dataset.order,
            'precio-asc': (a, b) => a.dataset.price - b.dataset.price || a.dataset.order - b.dataset.order,
            'precio-desc': (a, b) => b.dataset.price - a.dataset.price || a.dataset.order - b.dataset.order,
            nombre: (a, b) => a.dataset.name.localeCompare(b.dataset.name, loc),
            'nombre-desc': (a, b) => b.dataset.name.localeCompare(a.dataset.name, loc),
          }[mode];
          items.sort(by).forEach((el) => list.appendChild(el));
        }
      }

      // Cambia todos los textos de la página al idioma l, sin recargar.
      function setLang(l, guardar = true) {
        if (!V.d[l]) return;
        lang = l;
        const d = D();
        document.documentElement.lang = l;
        document.title = d.titulo;
        document.querySelectorAll('[data-t]').forEach((el) => {
          const v = d[el.dataset.t];
          if (v != null) el.textContent = v;
        });
        document.querySelectorAll('[data-ta]').forEach((el) => {
          el.dataset.ta.split(';').forEach((par) => {
            const [attr, key] = par.split('=');
            if (d[key] != null) el.setAttribute(attr, d[key]);
          });
        });
        const money = new Intl.NumberFormat(V.locales[l], { style: 'currency', currency: V.moneda });
        document.querySelectorAll('[data-precio]').forEach((el) => {
          el.textContent = (el.dataset.prefijo || '') + money.format(+el.dataset.precio);
        });
        document.querySelectorAll('.dish').forEach((el) => {
          el.dataset.name = d[`p:${el.dataset.id}:n`] ?? el.dataset.alt;
        });
        document.querySelectorAll('[data-solo-traducida]').forEach((el) => (el.hidden = l === V.original));
        // Desplegable
        const menuEl = document.getElementById('idioma-menu');
        if (menuEl) {
          menuEl.querySelectorAll('[data-set-lang]').forEach((b) => {
            const on = b.dataset.setLang === l;
            if (on) {
              b.setAttribute('aria-current', 'true');
              document.getElementById('idioma-bandera').innerHTML = b.querySelector('.bandera').innerHTML;
              document.getElementById('idioma-nombre').textContent = b.querySelector('.bandera + span').textContent;
            } else b.removeAttribute('aria-current');
          });
        }
        if (sortMode !== 'carta') {
          sortDishes(sortMode);
          sortCurrent.textContent = radios.find((r) => r.checked)?.parentElement.querySelector('span').textContent ?? '';
        }
        if (guardar) store.set(`vc-idioma-${V.slug}`, l);
        render();
      }

      function setView(view) {
        if (!viewBtns.length) view = 'list';
        root.dataset.view = view;
        viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
        if (viewBtns.length) store.set('vc-vista', view);
      }

      function openSearch() {
        searchbar.hidden = false;
        document.body.classList.add('searching');
        openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
        setNav('buscar');
        window.scrollTo({ top: 0 });
        input.focus();
      }
      function closeSearch() {
        searchbar.hidden = true;
        document.body.classList.remove('searching');
        openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
        setNav('carta');
        input.value = '';
        query = '';
        render();
      }

      chips.forEach((c) =>
        c.addEventListener('click', (e) => {
          e.preventDefault();
          active = c.dataset.cat;
          if (query) closeSearch();
          render();
          c.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
        }),
      );
      viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view)));
      // Hoja de "Ordenar por": elegir marca la opción, "Mostrar resultados" la aplica.
      sortOpen.addEventListener('click', () => {
        radios.forEach((r) => (r.checked = r.value === sortMode));
        sheet.showModal();
      });
      sheet.addEventListener('close', () => {
        if (sheet.returnValue !== 'apply') return;
        const picked = radios.find((r) => r.checked);
        sortMode = picked.value;
        sortDishes(sortMode);
        sortCurrent.textContent = picked.parentElement.querySelector('span').textContent;
        sortCurrent.hidden = sortMode === 'carta';
        sortOpen.classList.toggle('is-set', sortMode !== 'carta');
      });
      sheet.addEventListener('click', (e) => {
        if (e.target === sheet) sheet.close('cancel');
      });

      openers.forEach((b) => b.addEventListener('click', openSearch));
      document.querySelector('[data-close-search]').addEventListener('click', closeSearch);
      document.querySelector('[data-clear-search]').addEventListener('click', closeSearch);
      input.addEventListener('input', () => { query = input.value; render(); });
      input.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSearch(); });
      // Si el campo queda vacío y el usuario sale de él, la barra se cierra sola.
      input.addEventListener('blur', () => {
        setTimeout(() => {
          if (!input.value.trim() && !searchbar.contains(document.activeElement)) closeSearch();
        }, 150);
      });
      document.querySelectorAll('.bottomnav a').forEach((a) => a.addEventListener('click', () => { if (!searchbar.hidden) closeSearch(); }));

      // Desplegable de idioma: elegir cierra el menú; también se cierra al tocar fuera o con Escape.
      const menuIdioma = document.getElementById('idioma-menu');
      if (menuIdioma) {
        menuIdioma.querySelectorAll('[data-set-lang]').forEach((b) =>
          b.addEventListener('click', () => {
            setLang(b.dataset.setLang);
            menuIdioma.open = false;
            menuIdioma.querySelector('summary').focus();
          }),
        );
        document.addEventListener('click', (e) => { if (menuIdioma.open && !menuIdioma.contains(e.target)) menuIdioma.open = false; });
        menuIdioma.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menuIdioma.open) {
            menuIdioma.open = false;
            menuIdioma.querySelector('summary').focus();
          }
        });
      }

      // La barra inferior marca "Info" cuando esa sección está a la vista.
      const info = document.getElementById('info');
      if ('IntersectionObserver' in window && info) {
        new IntersectionObserver(([entry]) => {
          if (document.body.classList.contains('searching')) return;
          setNav(entry.isIntersecting ? 'info' : 'carta');
        }, { rootMargin: '0px 0px -40% 0px' }).observe(info);
      }

      setView(store.get('vc-vista') === 'grid' ? 'grid' : 'list');
      const guardado = store.get(`vc-idioma-${V.slug}`);
      if (guardado && guardado !== V.original && V.d[guardado]) setLang(guardado, false);
      else render();
    </script>
  </body>
</html>
