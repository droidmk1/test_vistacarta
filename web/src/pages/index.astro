---
// Índice de cartas publicadas. Si solo hay una, el visitante va directo a ella.
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/700.css';
import '@fontsource/figtree/800.css';
import '../styles/menu.css';

const menus = Object.values(import.meta.glob('../../../*/menu.json', { eager: true, import: 'default' }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cartas = menus
  .map((m) => ({ nombre: m.restaurante.nombre, href: `${base}/${m.restaurante.slug}/`, platos: m.categorias.reduce((n, c) => n + c.platos.length, 0) }))
  .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const unica = cartas.length === 1 ? cartas[0] : null;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#c8102e" />
    <title>VistaCarta</title>
    {unica && <meta http-equiv="refresh" content={`0; url=${unica.href}`} />}
  </head>
  <body class="index-body">
    <header class="appbar"><span class="brand-name">VistaCarta</span></header>
    <main class="index-main">
      <h1 class="index-title">Cartas</h1>
      <ul class="index-list">
        {cartas.map((c) => (
          <li>
            <a class="dish index-item" href={c.href}>
              <span class="dish-name">{c.nombre}</span>
              <span class="dish-price">{c.platos} platos</span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
